          "pass"
        ]
      }
    },
    {
      "lines": [
        "DENY",
        "REJECT",
        "allow"
      ],
      "matches": [
        false,
        false,
        true
      ],
      "name": "joined-exclusion",
      "settings": {
        "log_enable_exclude": true,
        "log_exclude_regex": [
          "(?i)deny",
          "reject"
        ]
      }
    },
    {
      "lines": [
        "no",
        "yes"
      ],
      "matches": [
        true,
        true
      ],
      "name": "empty-alternative",
      "settings": {
        "log_enable_include": true,
        "log_include_regex": [
          "",
          "yes"
        ]
      }
    },
    {
      "lines": [
        "[literal]",
        "literal",
        "[literal] deny"
      ],
      "matches": [
        true,
        false,
        false
      ],
      "name": "literal-and-exclusion",
      "settings": {
        "log_enable_exclude": true,
        "log_enable_include": true,
        "log_exclude_keyword": [
          "deny"
        ],
        "log_include_keyword": [
          "[literal]"
        ]
      }
    }
