{
  "name": "thronium-desktop",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "core:build": "python3 scripts/build_core.py",
    "test:engine": "cargo test --locked --manifest-path engine/Cargo.toml -j 2",
    "test:engine-live": "python3 scripts/engine_live.py",
    "test:core": "python3 scripts/test_core.py",
    "test:tun-core": "python3 scripts/test_tun.py",
    "test:xray-tun": "python3 scripts/test_xray_tun.py",
    "test:connection-core": "python3 scripts/test_core.py --connection",
    "test:selector-core": "python3 scripts/test_core.py --selector",
    "test:dynamic-selectors-core": "python3 scripts/test_dynamic_selectors.py",
    "test:group-chains-core": "python3 scripts/test_core.py --group-chains",
    "test:diagnostics-core": "python3 scripts/test_diagnostics_core.py",
    "test:chains-core": "python3 scripts/test_core.py --chains",
    "test:core-overlay": "python3 scripts/test_core_overlay.py",
    "test:fragment-core": "python3 scripts/test_fragment_core.py",
    "test:wireguard-core": "python3 scripts/test_wireguard_core.py",
    "test:wireguard-kernel": "python3 scripts/test_wireguard_kernel.py",
    "test:wireguard-system": "python3 scripts/test_wireguard_system.py",
    "test:system-dns-core": "python3 scripts/test_system_dns.py",
    "test:openresolv-core": "python3 scripts/test_openresolv.py",
    "test:legacy-routing-core": "python3 scripts/test_legacy_routing.py",
    "test:legacy-generated-dns-core": "python3 scripts/test_legacy_generated_dns.py",
    "test:vpn-otp-core": "python3 scripts/test_vpn_otp_fixture.py",
    "test:nested-routing-core": "python3 tests/nested_routing_core_oracle.py",
    "test:openconnect-cancel-core": "python3 tests/openconnect_cancel_core.py",
    "test:managed-vpn-core": "python3 tests/managed_vpn_core.py",
    "test:managed-credentials-core": "python3 tests/vpn_credentials_managed_public.py",
    "test:system-proxy-recovery-core": "python3 tests/system_proxy_recovery_review.py",
    "test:vpn-auth-core": "python3 tests/vpn_auth_public.py",
    "desktop:build": "tauri build --debug --no-bundle",
    "release:linux": "python3 scripts/build_core.py && NO_STRIP=true APPIMAGE_EXTRACT_AND_RUN=1 tauri build --bundles deb,rpm,appimage",
    "release:windows": "python3 scripts/windows_checkpoint.py --installer --release",
    "test:native": "python3 scripts/test_native.py",
    "native": "python3 scripts/native.py",
    "test:profiles": "node --test tests/profile-schema.test.mjs",
    "test:library": "node --test tests/library.test.mjs",
    "test:profile-core": "python3 scripts/test_core.py --profiles",
    "test:import": "node --test tests/import.test.mjs tests/import-formats.test.mjs",
    "test:import-core": "python3 scripts/test_core.py --imports",
    "test:routing-core": "python3 scripts/test_core.py --routing",
    "test:routing": "node --test tests/routing.test.mjs tests/condition-tree.test.mjs tests/headless-condition-tree.test.mjs tests/resources.test.mjs tests/routing-catalog.test.mjs",
    "test:tun-native": "python3 scripts/test_tun_native.py",
    "test:share": "node --test tests/share.test.mjs",
    "test:archives": "node --test tests/archives.test.mjs",
    "test:process-resources": "node --test tests/process-resources.test.mjs",
    "test:share-core": "python3 scripts/test_core.py --share",
    "typecheck": "tsc --noEmit && tsc -p tests/tsconfig.contracts.json",
    "test:unit": "node --test tests/*.test.mjs",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "rust:fmt": "cargo fmt --manifest-path engine/Cargo.toml && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "rust:fmt:check": "cargo fmt --manifest-path engine/Cargo.toml --check && cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "rust:clippy": "cargo clippy --locked --manifest-path engine/Cargo.toml --all-targets -j 2 && cargo clippy --locked --manifest-path src-tauri/Cargo.toml --all-targets -j 2",
    "check:frontend": "npm run version:check && npm run i18n:check && npm run typecheck && npm run lint && npm run format:check && npm run test:unit",
    "check:windows": "python3 scripts/windows_cross.py",
    "windows:checkpoint": "python3 scripts/windows_checkpoint.py",
    "version:check": "node scripts/version.mjs --check",
    "version:set": "node scripts/version.mjs",
    "contracts:generate": "cargo run --locked --manifest-path engine/Cargo.toml --bin export-contracts -j 2",
    "contracts:check": "cargo run --locked --manifest-path engine/Cargo.toml --bin export-contracts -j 2 -- --check",
    "i18n:generate": "node scripts/i18n.mjs",
    "i18n:check": "node scripts/i18n.mjs --check && node scripts/check-ui-text.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "fflate": "^0.8.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "^8.0.16"
  }
}
